# ==============================================================================
# MedVoice AI - Environment Variables Template
# Copy this file to `medvoice-ai/backend/.env` and fill in your credentials.
# NEVER commit your real `.env` file to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# Found in: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Retell AI Configuration
# Found in: https://beta.retellai.com/dashboard/api-keys
RETELL_API_KEY=key_your_retell_api_key
# Generated after running `npm run setup:retell` or copied from Retell dashboard
RETELL_AGENT_ID=agent_your_retell_agent_id

# Public URL for Webhooks (Required for live Retell webhooks when deployed)
BACKEND_PUBLIC_URL=https://your-backend-app.onrender.com
